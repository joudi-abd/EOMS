{"nodes": [{"id": "docs_adms_setup_ar_adms_push_gateway", "label": "Native ADMS/PUSH Gateway for iFace 880 Plus", "file_type": "concept", "source_file": "docs/ADMS_SETUP_AR.md", "source_location": "L1-L22", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The device initiates the connection and pushes punches/pulls commands; Laravel never connects to device port 4370, so no laptop bridge is needed when ADMS reaches the server directly."}, {"id": "docs_adms_setup_ar_iface_880_plus", "label": "ZKTeco iFace 880 Plus Device", "file_type": "concept", "source_file": "docs/ADMS_SETUP_AR.md", "source_location": "L5", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_adms_setup_ar_iclock_endpoints", "label": "/iclock/* Endpoints (cdata, getrequest, devicecmd, ping, registry)", "file_type": "concept", "source_file": "docs/ADMS_SETUP_AR.md", "source_location": "L122-L131", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_adms_setup_ar_attlog_format", "label": "ATTLOG Tab-Separated Punch Format", "file_type": "concept", "source_file": "docs/ADMS_SETUP_AR.md", "source_location": "L133-L139", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Raw request and punches are stored in one transaction before replying OK so the device retries on storage failure; dedupe key derived from the punch line."}, {"id": "docs_adms_setup_ar_configure_adms_command", "label": "attendance:configure-adms Artisan Command", "file_type": "code", "source_file": "docs/ADMS_SETUP_AR.md", "source_location": "L51-L59", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_adms_setup_ar_hr_attendance_devices", "label": "hr_attendance_devices Table (adms_source_ip)", "file_type": "concept", "source_file": "docs/ADMS_SETUP_AR.md", "source_location": "L15", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_adms_setup_ar_connection_mode", "label": "Device connection_mode (adms | bridge)", "file_type": "concept", "source_file": "docs/ADMS_SETUP_AR.md", "source_location": "L90-L108", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Once switched to adms the device rejects the legacy JSON device-ingest so an old bridge token cannot bypass ADMS guarantees."}, {"id": "docs_adms_setup_ar_env_flags", "label": "ATTENDANCE_ADMS_* Env Flags", "file_type": "concept", "source_file": "docs/ADMS_SETUP_AR.md", "source_location": "L41-L49", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_adms_setup_ar_source_ip_allowlist", "label": "Source IP Allowlist and Trusted Network Requirement", "file_type": "rationale", "source_file": "docs/ADMS_SETUP_AR.md", "source_location": "L110-L120", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "SN and IP allowlist are not cryptographic device auth; deployment requires VPN preserving device addresses, middleware ignores X-Forwarded-For to prevent IP spoofing, and trustProxies('*') must not be used."}, {"id": "docs_adms_setup_ar_confirm_sync", "label": "Manual Device Sync Confirmation (confirm-sync / complete_through)", "file_type": "concept", "source_file": "docs/ADMS_SETUP_AR.md", "source_location": "L141-L151", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "complete_through is never advanced from heartbeat or ATTLOG batches because the protocol does not guarantee historical completeness; an attendance admin confirms explicitly."}, {"id": "docs_adms_setup_ar_remote_fingerprint_enrollment", "label": "Remote Fingerprint Enrollment Workflow (USERINFO / ENROLL_FP)", "file_type": "concept", "source_file": "docs/ADMS_SETUP_AR.md", "source_location": "L153-L194", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rati