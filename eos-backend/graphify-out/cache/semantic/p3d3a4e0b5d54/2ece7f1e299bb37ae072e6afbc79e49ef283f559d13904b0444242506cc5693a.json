{"nodes": [{"id": "_claude_skills_deploying_to_cloud_skill", "label": "Deploying to Laravel Cloud skill", "file_type": "document", "source_file": ".claude/skills/deploying-to-cloud/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": "laravel", "contributor": null}, {"id": "_claude_skills_deploying_to_cloud_skill_cloud_cli", "label": "Laravel Cloud CLI (./vendor/bin/cloud)", "file_type": "concept", "source_file": ".claude/skills/deploying-to-cloud/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": "laravel", "contributor": null, "rationale": "Use CLI rather than guessing dashboard/API workflows; project-local install preferred, global as fallback"}, {"id": "_claude_skills_deploying_to_cloud_skill_cloud_environments", "label": "Cloud environments (production/staging/preview)", "file_type": "rationale", "source_file": ".claude/skills/deploying-to-cloud/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": "laravel", "contributor": null, "rationale": "Each environment has its own compute, resources and deployment settings"}, {"id": "_claude_skills_deploying_to_cloud_skill_build_vs_deploy_commands", "label": "Build vs deploy commands", "file_type": "rationale", "source_file": ".claude/skills/deploying-to-cloud/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": "laravel", "contributor": null, "rationale": "Optimization/caching belongs in build; deploy (e.g. migrate --force) runs right before release; deploy filesystem changes not persisted; 15-minute timeout"}, {"id": "_claude_skills_deploying_to_cloud_skill_forbidden_deploy_commands", "label": "Forbidden deploy commands (queue:restart, horizon:terminate, optimize:clear, storage:link)", "file_type": "rationale", "source_file": ".claude/skills/deploying-to-cloud/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": "laravel", "contributor": null, "rationale": "Cloud handles worker restarts and process management; deploy filesystem changes are not persistent"}, {"id": "_claude_skills_deploying_to_cloud_skill_ephemeral_filesystem", "label": "Ephemeral environment filesystem", "file_type": "rationale", "source_file": ".claude/skills/deploying-to-cloud/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": "laravel", "contributor": null, "rationale": "Not shared between replicas and lost on deploy; use DB/Valkey for cache & sessions and Object Storage for files"}, {"id": "_claude_skills_deploying_to_cloud_skill_cloud_object_storage", "label": "Laravel Cloud Object Storage (Cloudflare R2)", "file_type": "concept", "source_file": ".claude/skills/deploying-to-cloud/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": "laravel", "contributor": null, "rationale": "R2 applies visibility at bucket level, so private default disk + separate public bucket; no per-object visibility ACLs"}, {"id": "_claude_skills_deploying_to_cloud_skill_secrets_manager", "label": "Cloud Secrets Manager", "file_type": "concept", "source_file": ".claude/skills/deploying-to-cloud/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": "laravel", "contributor": null, "rationale": "Encrypted org-level values encrypted locally by CLI; pipe values in to avoid shell history; requires sodium; redeploy after changes"}, {"id": "_claude_skills_deploying_to_cloud_skill_managed_queues", "label": "Managed queues", "file_type": "concept", "source_file": ".claude/skills/deploying-to-cloud/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": "laravel", "contributor": null, "rationale": "Recommended: dedicated autoscaling workers; scale-to-zero may interrupt long jobs"}, {"id": "_claude_skills_deploying_to_cloud_skill_cloud_scheduler", "label": "Cloud scheduler and onOneServer", "file_type": "rationale", "source_file": ".claude/skills/deploying-to-cloud/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": "laravel", "contributor": null, "rationale": "schedule:run every minute; use onOneServer with multiple replicas"}, {"id": "_claude_skills_deploying_to_cloud_skill_cli_flag_combos", "label": "CLI flag combos (-n, --json, --force)", "file_type": "rationale", "source_file": ".claude/skills/deploying-to-cloud/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": "laravel", "contributor": null, "rationale": "Always -n to avoid hanging; never -q/--silent since they suppress output"}, {"id": "_claude_skills_deploying_to_cloud_skill_deploy_then_monitor", "label": "Deploy then monitor workflow", "file_type": "rationale", "source_file": ".claude/skills/deploying-to-cloud/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": "laravel", "contributor": null, "rationale": "Always run deploy:monitor after every deploy; on failure read deployment:logs before fixing"}, {"id": "_claude_skills_deploying_to_cloud_skill_error_loop_rule", "label": "Error loop rule (fix once, then ask)", "file_type": "rationale", "source_file": ".claude/skills/deploying-to-cloud/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": "laravel", "contributor": null, "rationale": "Avoid repeating failing operations; diagnose, fix once, ask user if it fails again"}, {"id": "_claude_skills_deploying_to_cloud_skill_destructive_confirmation", "label": "Confirm destructive commands with user", "file_type": "rationale", "source_file": ".claude/skills/deploying-to-cloud/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": "laravel", "contributor": null, "rationale": "Deleting apps, environments, DBs, caches, buckets, domains, secrets or detaching Resend requires approval"}, {"id": "_claude_skills_deploying_to_cloud_skill_subagent_delegation", "label": "Subagent delegation for high-output commands", "file_type": "rationale", "source_file": ".claude/skills/deploying-to-cloud/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": "laravel", "contributor": null, "rationale": "Keep main context window small; verbose logs/JSON stay in subagent"}, {"id": "_claude_skills_deploying_to_cloud_skill_resend_email", "label": "Resend email integration", "file_type": "concept", "source_file": ".claude/skills/deploying-to-cloud/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": "laravel", "contributor": null, "rationale": "Domains verified in dashboard only; attach sets RESEND_API_KEY and MAIL_* vars; requires resend/resend-php"}, {"id": "_claude_skills_deploying_to_cloud_skill_cloud_tinker", "label": "cloud tinker / command:run remote access", "file_type": "concept", "source_file": ".claude/skills/deploying-to-cloud/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": "laravel", "contributor": null}, {"id": "_claude_skills_deploying_to_cloud_skill_billing_usage", "label": "cloud usage billing queries", "file_type": "rationale", "source_file": ".claude/skills/deploying-to-cloud/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": "laravel", "contributor": null, "rationale": "Amounts in cents, camelCase keys"}, {"id": "_claude_skills_deploying_to_cloud_skill_cli_config_precedence", "label": "CLI config precedence (LARAVEL_CLOUD_TOKEN, global, repo-local .cloud/config.json)", "file_type": "rationale", "source_file": ".claude/skills/deploying-to-cloud/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": "laravel", "contributor": null, "rationale": "Env token overrides saved; CLI args override config files; multi-org needs organization_id"}, {"id": "_claude_skills_deploying_to_cloud_skill_cloud_docs_llms_txt", "label": "Laravel Cloud documentation (llms.txt)", "file_type": "concept", "source_file